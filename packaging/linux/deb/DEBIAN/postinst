#!/bin/sh
set -e

case "$1" in
    configure)
        # Ensure system credentials directory exists with secure permissions
        mkdir -p /etc/endpoint-agent
        chmod 700 /etc/endpoint-agent

        # Register and configure systemd service if binary exists
        if [ -x /usr/bin/endpoint-agent ]; then
            /usr/bin/endpoint-agent -service install || true
        fi

        # If systemd is running, reload daemon and enable service
        if [ -d /run/systemd/system ]; then
            systemctl daemon-reload || true
            systemctl enable endpoint-agent.service || true

            # Only (re)start when the agent has already enrolled. Enrollment
            # writes the credentials file, and until it exists there is nothing
            # for the service to authenticate with -- starting it would just
            # crash-loop until the operator enrolls the machine. The file the
            # agent actually writes is $HOME/.endpoint-mgmt/agent-creds.json
            # (see defaultCredsPath in agent/cmd/agent/main.go); under systemd
            # HOME=/root, so that is where a freshly-enrolled host keeps it.
            if [ -f /root/.endpoint-mgmt/agent-creds.json ]; then
                systemctl restart endpoint-agent.service || true
            fi
        fi

        # Say plainly what state this leaves. Before this line the script
        # ended with the unit enabled but not running, and nothing told the
        # operator why -- it read like a successful, completed install.
        echo
        echo "endpoint-agent installed and enabled for boot."
        echo "It is NOT running until this endpoint enrolls:"
        echo "  endpoint-agent -enroll -token <enrollment-token> -server https://<server>:8443"
        echo "  systemctl start endpoint-agent"
    ;;
    abort-upgrade|abort-remove|abort-deconfigure)
    ;;
    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
    ;;
esac

exit 0
