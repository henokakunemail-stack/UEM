#!/bin/sh
# postinstall script for Endpoint Management Agent macOS PKG
set -e

BIN="/usr/local/bin/endpoint-agent"
PLIST="/Library/LaunchDaemons/com.endpoint-mgmt.agent.plist"
CONFIG_DIR="/etc/endpoint-agent"
CREDS_FILE="$CONFIG_DIR/creds.json"

# Ensure directories exist
mkdir -p /usr/local/bin
mkdir -p "$CONFIG_DIR"
chmod 700 "$CONFIG_DIR"

if [ -f "$BIN" ]; then
    chmod 755 "$BIN"
fi

# Unattended enrollment. An MDM (or an operator) that drops
# /etc/endpoint-agent/enroll.conf before installing the package gets an
# enrolled device with no second step:
#
#   SERVER_URL=https://mgmt.example.com
#   ENROLL_TOKEN=<token from the console>
#   SITE=<optional site label>
#
# The token is single-use, so the file is deleted whatever the outcome; a
# failed enrollment is logged and the device can be enrolled by hand later.
ENROLL_CONF="$CONFIG_DIR/enroll.conf"
if [ -f "$ENROLL_CONF" ] && [ ! -f "$CREDS_FILE" ] && [ -x "$BIN" ]; then
    SERVER_URL=$(sed -n 's/^SERVER_URL=//p' "$ENROLL_CONF" | head -n1)
    ENROLL_TOKEN=$(sed -n 's/^ENROLL_TOKEN=//p' "$ENROLL_CONF" | head -n1)
    SITE=$(sed -n 's/^SITE=//p' "$ENROLL_CONF" | head -n1)
    if [ -n "$SERVER_URL" ] && [ -n "$ENROLL_TOKEN" ]; then
        set -- -server "$SERVER_URL" -enroll "$ENROLL_TOKEN" -enroll-only -creds "$CREDS_FILE"
        if [ -n "$SITE" ]; then
            set -- "$@" -site "$SITE"
        fi
        "$BIN" "$@" >>/var/log/endpoint-agent-install.log 2>&1 ||
            echo "enrollment failed; see /var/log/endpoint-agent-install.log"
    fi
    rm -f "$ENROLL_CONF"
fi

# Write launchd daemon plist if not already present
cat <<'EOF' > "$PLIST"
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.endpoint-mgmt.agent</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/bin/endpoint-agent</string>
		<string>-creds</string>
		<string>/etc/endpoint-agent/creds.json</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<dict>
		<key>PathState</key>
		<dict>
			<key>/etc/endpoint-agent/creds.json</key>
			<true/>
		</dict>
	</dict>
	<key>StandardOutPath</key>
	<string>/var/log/endpoint-agent.log</string>
	<key>StandardErrorPath</key>
	<string>/var/log/endpoint-agent.err</string>
</dict>
</plist>
EOF

chmod 644 "$PLIST"
chown root:wheel "$PLIST"

# Load daemon into launchd
launchctl bootstrap system "$PLIST" 2>/dev/null || launchctl load -w "$PLIST" 2>/dev/null || true

exit 0
