# The build context is the whole repository, but a container build needs none
# of the local machine's leftovers. Excluding them keeps the context small and
# stops a Windows-built node_modules or a stale dist/ from being copied in and
# compiled into the image.

# Version control and agent tool state
.git
.github
.claude

# Local runtime state: the server state, agent secrets, and a real database
# copy must never end up in an image layer
data/
.testrun/
**/.testrun/
pic/
tmpagent/
*.db
*.db-wal
*.db-shm
*-creds.json
.env

# Frontend: node_modules is reinstalled inside the image for the right platform,
# and dist is the output of the build rather than an input to it
web-console/node_modules
web-console/dist
# The embed directory is regenerated by `npm run build` inside the image. Keeping
# the committed copy out of the context guarantees the binary embeds a bundle
# built from the sources in this checkout, not one left over from an older one.
server/cmd/server/dist

# Build outputs from the host
*.exe
server.exe
agent.exe
bin/

# Not part of the build
docs
scripts
tests
progress.md
