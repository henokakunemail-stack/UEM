# Build output
*.exe
*.exe~
server.exe
agent.exe
emagent-*
emserver
emserver.exe
emagent
emagent.exe
bin/
tmpagent/
deploy/bin/
deploy/*-linux-*

# Frontend build & dependencies
web-console/dist/
web-console/node_modules/

# server/cmd/server/dist is NOT ignored, and that is deliberate. //go:embed
# captures it at compile time, and the Go CI job runs `go build ./...` without
# installing npm first — so the compiled console has to be in the repository or
# that job has nothing to embed. The cost is a content-hashed filename changing
# on every build, which is why the frontend job asserts the bundle in dist is
# the one index.html actually references.

# Local runtime data (server state must never be committed)
data/
*.db
*.db-wal
*.db-shm

# Agent credentials issued during testing
.env
*-creds.json

# Local test scratch. .testrun/creds.json holds a real device secret and
# .testrun/data/backups/ holds copies of the operational database, so the whole
# directory stays out of the repo rather than relying on a filename pattern that
# a future run could rename around.
.testrun/
**/.testrun/

# Editor / OS noise
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Claude Code local state: worktrees are full checkouts, settings are personal
.claude/

# Working screenshots from verification runs, not product assets
pic/

# Session-to-session handoff notes. Useful locally, noise in a public repo:
# it describes what the next session should do rather than what the code is.
progress.md
